          },
          "components": [
            {
              "type": "textfield",
              "id": "Textfield_company",
              "key": "company",
              "label": "Company"
            }
          ]
        },
        {
          "type": "page",
          "id": "Page_3",
          "label": "Summary",
          "components": [
            {
              "type": "textfield",
              "id": "Textfield_comment",
              "key": "comment",
              "label": "Comment"
            }
          ]
