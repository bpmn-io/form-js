{
  "type": "default",
  "id": "GatedMultiPageForm",
  "components": [
    {
      "type": "multipage",
      "id": "Multipage_1",
      "showSubmit": true,
      "disableInvalidNavigation": true,
      "components": [
        {
          "type": "page",
          "id": "Page_1",
          "label": "First",
          "components": [
            {
              "type": "textfield",
              "id": "Textfield_name",
              "key": "name",
              "label": "Name",
              "validate": {
                "required": true
              }
            }
          ]
        },
        {
          "type": "page",
          "id": "Page_2",
          "label": "Second",
          "components": [
            {
              "type": "textfield",
              "id": "Textfield_note",
              "key": "note",
              "label": "Note",
              "validate": {
                "required": true
              }
            }
          ]
        }
      ]
    }
  ]
}
