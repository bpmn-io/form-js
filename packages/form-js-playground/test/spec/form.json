{
  "$schema": "../../../form-json-schema/resources/schema.json",
  "components": [
    {
      "type": "filepicker",
      "key": "filepicker",
      "accept": ".png,.jpg",
      "multiple": true,
      "layout": {
        "row": "Row_1"
      }
    },
    {
      "type": "expression",
      "key": "expressionResult",
      "expression": "= 3 + 4",
      "computeOn": "change",
      "layout": {
        "row": "Row_2"
      }
    },
    {
      "type": "text",
      "text": "# Invoice\nLorem _ipsum_ __dolor__ `sit`.\n  \n  \nA list of BPMN symbols:\n* Start Event\n* Task\nLearn more about [forms](https://bpmn.io).\n  \n  \nThis [malicious link](javascript:throw onerror=alert,'some string',123,'haha') __should not work__.",
      "layout": {
        "row": "Row_3",
        "columns": 8
      }
    },
    {
      "type": "html",
      "content": "<h1>My HTML</h1><p style='color: green'>My styled HTML content</p>",
      "layout": {
        "row": "Row_3",
        "columns": 8
      }
    },
    {
      "type": "iframe",
      "label": "An example page rendered in an iframe",
      "url": "https://example.com/",
      "layout": {
        "row": "Row_4"
      }
    },
    {
      "type": "group",
      "label": "Supplementary Information",
      "path": "invoiceDetails",
      "showOutline": true,
      "components": [
        {
          "id": "GroupTextfield_1",
          "type": "textfield",
          "key": "supplementaryInfo1",
          "label": "Field 1",
          "layout": {
            "row": "Row_6"
          }
        },
        {
          "id": "GroupTextfield_2",
          "type": "textfield",
          "key": "supplementaryInfo2",
          "label": "Field 2",
          "layout": {
            "row": "Row_7"
          }
        }
      ],
      "layout": {
        "row": "Row_5"
      }
    },
    {
      "type": "dynamiclist",
      "label": "Clients",
      "path": "clients",
      "showOutline": true,
      "isRepeating": true,
      "defaultRepetitions": 2,
      "allowAddRemove": true,
      "components": [
        {
          "id": "DynamicListTextField_1",
          "type": "textfield",
          "key": "clientSurname",
          "label": "Surname",
          "layout": {
            "row": "Row_9"
          }
        },
        {
          "id": "DynamicListTextField_2",
          "type": "textfield",
          "key": "clientName",
          "label": "Name",
          "layout": {
            "row": "Row_10"
          }
        }
      ],
      "layout": {
        "row": "Row_8"
      }
    },
    {
      "key": "creditor",
      "label": "Creditor",
      "type": "textfield",
      "validate": {
        "required": true
      },
      "layout": {
        "row": "Row_11"
      }
    },
    {
      "description": "An invoice number in the format: C-123.",
      "key": "invoiceNumber",
      "label": "Invoice Number",
      "type": "textfield",
      "validate": {
        "pattern": "^C-[0-9]+$"
      },
      "layout": {
        "row": "Row_12"
      }
    },
    {
      "key": "amount",
      "label": "Amount",
      "type": "number",
      "validate": {
        "min": 0,
        "max": 1000
      },
      "layout": {
        "row": "Row_13"
      }
    },
    {
      "key": "approved",
      "label": "Approved",
      "type": "checkbox",
      "layout": {
        "row": "Row_14"
      }
    },
    {
      "key": "approvedBy",
      "label": "Approved By",
      "type": "textfield",
      "layout": {
        "row": "Row_15"
      }
    },
    {
      "key": "approverComments",
      "label": "Approver comments",
      "type": "textarea",
      "layout": {
        "row": "Row_16"
      }
    },
    {
      "type": "checkbox",
      "label": "Checkbox",
      "key": "isGood",
      "layout": {
        "row": "Row_17"
      }
    },
    {
      "type": "separator",
      "layout": {
        "row": "Row_18"
      }
    },
    {
      "type": "select",
      "key": "selectMe",
      "label": "Select me",
      "valuesExpression": "=if isGood then [ \"good\" ] else [\"bad\"]",
      "layout": {
        "row": "Row_19"
      }
    },
    {
      "key": "hobbies",
      "label": "Hobbies",
      "type": "taglist",
      "valuesExpression": "=hobbies",
      "layout": {
        "row": "Row_20"
      }
    },
    {
      "key": "mailto",
      "label": "Email data to",
      "type": "checklist",
      "values": [
        {
          "label": "Approver",
          "value": "approver"
        },
        {
          "label": "Manager",
          "value": "manager"
        },
        {
          "label": "Regional Manager",
          "value": "regional-manager"
        }
      ],
      "layout": {
        "row": "Row_21"
      }
    },
    {
      "key": "product",
      "label": "Product",
      "type": "radio",
      "values": [
        {
          "label": "Camunda Platform",
          "value": "camunda-platform"
        },
        {
          "label": "Camunda Cloud",
          "value": "camunda-cloud"
        }
      ],
      "layout": {
        "row": "Row_22"
      }
    },
    {
      "key": "dri",
      "label": "Assign DRI",
      "type": "radio",
      "valuesKey": "queriedDRIs",
      "layout": {
        "row": "Row_23"
      }
    },
    {
      "key": "tags",
      "label": "Taglist",
      "type": "taglist",
      "values": [
        {
          "label": "Tag1",
          "value": "tag1"
        },
        {
          "label": "Tag2",
          "value": "tag2"
        },
        {
          "label": "Tag3",
          "value": "tag3"
        },
        {
          "label": "Tag4",
          "value": "tag4"
        },
        {
          "label": "Tag5",
          "value": "tag5"
        },
        {
          "label": "Tag6",
          "value": "tag6"
        },
        {
          "label": "Tag7",
          "value": "tag7"
        },
        {
          "label": "Tag8",
          "value": "tag8"
        },
        {
          "label": "Tag9",
          "value": "tag9"
        },
        {
          "label": "Tag10",
          "value": "tag10"
        },
        {
          "label": "Tag11",
          "value": "tag11"
        }
      ],
      "layout": {
        "row": "Row_24"
      }
    },
    {
      "key": "language",
      "label": "Language",
      "type": "select",
      "values": [
        {
          "label": "German",
          "value": "german"
        },
        {
          "label": "English",
          "value": "english"
        }
      ],
      "layout": {
        "row": "Row_25"
      }
    },
    {
      "key": "conversation",
      "type": "datetime",
      "subtype": "datetime",
      "dateLabel": "Date of conversation",
      "timeLabel": "Time of conversation",
      "timeSerializingFormat": "utc_normalized",
      "timeInterval": 15,
      "use24h": false,
      "layout": {
        "row": "Row_26"
      }
    },
    {
      "source": "=logo",
      "alt": "The bpmn.io logo",
      "type": "image",
      "layout": {
        "row": "Row_27"
      }
    },
    {
      "label": "Document preview",
      "type": "documentPreview",
      "dataSource": "=documents",
      "id": "Field_1w82te0",
      "layout": {
        "row": "Row_28"
      }
    },
    {
      "label": "Submit",
      "type": "button",
      "layout": {
        "row": "Row_29"
      }
    },
    {
      "action": "reset",
      "label": "Reset",
      "type": "button",
      "layout": {
        "row": "Row_30"
      }
    }
  ],
  "type": "default"
}
